---
import { profile } from '../data/site';
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="#top" aria-label="Kirshway home"
      >Kirshway<span aria-hidden="true">.</span></a
    >
    <nav
      class="site-navigation"
      aria-label="Primary navigation"
      data-navigation
    >
      <button
        class="navigation-toggle"
        type="button"
        aria-label="Menu"
        popovertarget="primary-navigation-links"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.65"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path class="navigation-toggle__line" d="M2 12h20"></path>
          <path class="navigation-toggle__line" d="M2 12h20"></path>
          <path class="navigation-toggle__line" d="M2 12h20"></path>
        </svg>
      </button>
      <div
        class="navigation-links"
        id="primary-navigation-links"
        popover="auto"
      >
        {
          profile.nav.map((link) => (
            <a class="nav-link" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  import '../scripts/navigation';
</script>

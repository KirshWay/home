---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  src: ImageMetadata;
  alt: string;
  fit?: 'cover' | 'contain';
};

const { src, alt, fit = 'cover' } = Astro.props;
const sample = await getImage({ src, width: 640, format: 'webp', quality: 90 });
---

<ascii-portrait data-source={sample.src} data-fit={fit}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[320, 480, 640]}
    sizes="(min-width: 1100px) 270px, (min-width: 640px) 180px, 96px"
    loading="eager"
  />
  <canvas aria-hidden="true"></canvas>
</ascii-portrait>

<script>
  import '../scripts/ascii-portrait';
</script>

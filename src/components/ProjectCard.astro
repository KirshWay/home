---
import { Picture } from 'astro:assets';
import type { Project } from '../types/site';
type Props = { project: Project; index: number };
const { project, index } = Astro.props;
const PreviewTag = project.website ? 'a' : 'div';
---

<article class="tile project-card">
  {
    project.preview.kind === 'screenshot' ? (
      <PreviewTag
        class="project-preview"
        href={project.website}
        {...(project.website && {
          'aria-label': `Visit ${project.name} website`,
          target: '_blank',
          rel: 'noreferrer',
        })}
      >
        <div class="preview-caption">
          <span>{project.website && new URL(project.website).hostname}</span>
          {project.website && <span aria-hidden="true">↗</span>}
        </div>
        <Picture
          src={project.preview.src}
          alt={project.preview.alt}
          widths={[640, 960, 1400]}
          formats={['avif', 'webp']}
          sizes="(min-width: 1440px) 490px, (min-width: 1100px) 34vw, (min-width: 640px) 45vw, 90vw"
          loading="lazy"
        />
      </PreviewTag>
    ) : (
      <div class="project-artwork">
        <Picture
          class="project-icon"
          src={project.preview.src}
          alt={project.preview.alt}
          widths={[96, 192]}
          formats={['webp']}
          sizes="96px"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="project-copy card-pad">
    <div class="card-heading">
      <span class="eyebrow"
        >{`Personal project / ${String(index + 1).padStart(2, '0')}`}</span
      >
    </div>
    <h3 class="project-title">{project.name}</h3>
    <p class="body-copy">{project.description}</p>
    <div class="project-footer">
      <p class="project-tags">{project.tags.slice(0, 3).join(' · ')}</p>
      <div class="card-links">
        {
          project.website && (
            <a
              class="text-link"
              href={project.website}
              target="_blank"
              rel="noreferrer"
            >
              Website <span aria-hidden="true">↗</span>
            </a>
          )
        }
        <a
          class="text-link"
          href={project.href}
          target="_blank"
          rel="noreferrer"
          aria-label={`${project.name} on GitHub`}
          >GitHub <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </div>
</article>
